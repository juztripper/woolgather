{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woolgather",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_VOICE_SESSIONS", "class_name": "ProjectVoiceSession" },
    ],
  },
  "migrations": [
    {
      "tag": "project-voice-v1",
      "new_sqlite_classes": ["ProjectVoiceSession"],
    },
  ],
  "assets": {
    "directory": "dist/web/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "IDEA_GUIDANCE_ENABLED": "false",
    "IDEA_GUIDANCE_MODEL": "gpt-5.6-sol",
    "IDEA_GUIDANCE_EFFORT": "low",
    "PROJECT_PLANNING_ENABLED": "false",
    "PROJECT_VOICE_ENABLED": "false",
    "PROJECT_PLANNING_MODEL": "gpt-5.6-sol",
    "BILLING_TEST_ENABLED": "false",
    "PLAN_ALLOWANCES_ENABLED": "false",
    "STRIPE_BILLING_ENABLED": "false",
    "STRIPE_BILLING_MODE": "test",
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": "",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
