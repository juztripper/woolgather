{
  "compilerOptions": {
    "paths": { "@/*": ["./apps/web/src/*"] },
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ]
}
