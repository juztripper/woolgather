{
  "name": "woolgather",
  "version": "0.1.0",
  "description": "Build from your woolgather plan using your own coding agent and account.",
  "author": { "name": "Ripper's Games" },
  "license": "AGPL-3.0-only",
  "mcpServers": {
    "woolgather": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/start.mjs"],
      "env": {
        "WOOLGATHER_URL": "${WOOLGATHER_URL}",
        "WOOLGATHER_TOKEN": "${WOOLGATHER_TOKEN}",
        "WOOLGATHER_CONNECTOR_PATH": "${WOOLGATHER_CONNECTOR_PATH}"
      }
    }
  }
}
