{
  "name": "woolgather",
  "version": "0.1.0",
  "description": "A calm workspace for turning rough ideas into durable, understandable projects.",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Ripper's Games",
  "homepage": "https://woolgathering.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/juztripper/woolgather.git"
  },
  "bugs": {
    "url": "https://github.com/juztripper/woolgather/issues"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@12.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4200",
    "build": "npm run check:ui && tsc --noEmit && vite build && tsx scripts/prepare-public-pages.ts",
    "test": "node scripts/test-local.mjs",
    "types": "wrangler types --strict-vars false",
    "preview": "vite preview --host 127.0.0.1 --port 4200",
    "check:format": "prettier --check apps packages plugins scripts tests .github README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md THIRD_PARTY_NOTICES.md *.json *.jsonc *.ts",
    "deploy:check": "wrangler deploy --dry-run --config dist/web/woolgather/wrangler.json",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@blocknote/core": "0.54.2",
    "@blocknote/react": "0.54.2",
    "@blocknote/shadcn": "0.54.2",
    "@floating-ui/react": "0.27.20",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@supabase/supabase-js": "2.115.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "animejs": "4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.41.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "sonner": "^2.0.8",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.131.0"
  }
}
